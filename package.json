{
  "name": "security-scanner",
  "version": "2.2.0",
  "description": "Modular CLI & Web UI security scanner — Next.js, Spring Boot, AI/LLM & MCP exposure, SRI Supply Chain, Laravel, PHP, WordPress. Real-time dashboard and dark-mode HTML reports.",
  "type": "module",
  "bin": {
    "secscan": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "scan": "node bin/cli.js",
    "ui": "node bin/cli.js --ui",
    "ui:watch": "node --watch core/server.js",
    "cve:audit": "node bin/cli.js --cve-audit",
    "cve:confirm": "node bin/cli.js --cve-audit --cve-db osv",
    "cve:lab": "node bin/cli.js --cve-lab",
    "pc:audit": "node bin/cli.js --pc-local",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:watch": "docker compose up --watch",
    "docker:logs": "docker compose logs -f secscan",
    "docker:down": "docker compose down",
    "test": "node --test"
  },
  "dependencies": {
    "p-limit": "^5.0.0"
  }
}
